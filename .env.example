# MangoVoice — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ── Required API keys ─────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Model configuration ───────────────────────────────────────────────────────
GROQ_MODEL=llama-3.1-8b-instant
GROQ_SAFETY_MODEL=llama-guard-3-8b
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Data / index paths ────────────────────────────────────────────────────────
INDEX_PATH=data/lancedb
INDEX_VERSION=v1
INDEX_TABLE=chunks

# ── App limits ────────────────────────────────────────────────────────────────
MAX_AUDIO_SECONDS=25
MAX_OUTPUT_TOKENS=128

# ── Environment ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=false

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Only needed if backend is on a different origin
# NEXT_PUBLIC_API_BASE=https://your-backend-url.vercel.app
